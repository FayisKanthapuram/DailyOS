# ============================================================
# DailyOS Mobile — Environment Configuration Template
# ============================================================
# Copy this file to mobile/.env.local and set your target URL.
# NEVER commit mobile/.env.local or secret values to Git.
# ============================================================

# ── Target Backend Base URL ─────────────────────────────────
#
# Options for EXPO_PUBLIC_API_URL:
#
# 1. Local iOS Simulator:
#    EXPO_PUBLIC_API_URL=http://localhost:3001/api
#
# 2. Local Android Emulator:
#    EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api
#    (Note: if set to localhost, DailyOS automatically maps it to 10.0.2.2 on Android)
#
# 3. Local Physical Device (iPhone / Android via Expo Go on Wi-Fi):
#    EXPO_PUBLIC_API_URL=http://192.168.x.x:3001/api
#    (Replace 192.168.x.x with your Mac's LAN IP address from `ipconfig` / `ifconfig`)
#
# 4. Deployed Production Backend (Render):
#    EXPO_PUBLIC_API_URL=https://dailyos-api.onrender.com/api
#
EXPO_PUBLIC_API_URL=http://localhost:3001/api
