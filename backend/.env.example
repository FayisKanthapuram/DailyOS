# ============================================================
# DailyOS Backend — Environment Configuration
# ============================================================
# DEVELOPMENT: Copy to backend/.env and fill in values.
# PRODUCTION:  Set all values via Render Dashboard → Environment.
# NEVER commit a file containing real secrets.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Development: local Docker PostgreSQL
DATABASE_URL=postgresql://dailyos:dailyos@127.0.0.1:5433/dailyos
# Production: Render provides this automatically when using render.yaml
# DATABASE_URL=postgresql://user:pass@host.render.com:5432/dailyos?sslmode=require

# ── JWT Secrets ───────────────────────────────────────────────
# IMPORTANT: Use long, random secrets in production (min 64 characters).
# Generate with: openssl rand -hex 64
# NEVER use the development placeholders in production.
JWT_SECRET=dev-jwt-access-secret-change-this-min-16-chars
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-this-min-16-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── Application ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Production: NODE_ENV=production

# ── CORS / Frontend URL ───────────────────────────────────────
# Development: local Vite dev server
FRONTEND_URL=http://localhost:5173
# Production: your Vercel URL (set in Render Dashboard)
# FRONTEND_URL=https://dailyos.vercel.app

# Optional: comma-separated list of ADDITIONAL allowed CORS origins.
# Falls back to FRONTEND_URL if not set.
# CORS_ORIGIN=https://dailyos.vercel.app,https://www.dailyos.app

# ── Google OAuth ──────────────────────────────────────────────
# Required only if Google login is enabled.
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Add to "Authorized redirect URIs":
#   Development: http://localhost:3001/api/auth/google/callback
#   Production:  https://dailyos-api.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
# Production example:
# GOOGLE_CALLBACK_URL=https://dailyos-api.onrender.com/api/auth/google/callback
