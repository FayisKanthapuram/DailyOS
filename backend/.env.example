# Database
DATABASE_URL=postgresql://dailyos:dailyos@127.0.0.1:5433/dailyos

# JWT
JWT_SECRET=your-jwt-access-secret-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Google OAuth (Optional - required only for Google Login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
