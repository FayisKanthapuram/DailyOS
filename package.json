{
  "name": "dailyos",
  "private": true,
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0"
  },
  "lint-staged": {
    "frontend/src/**/*.{ts,tsx}": [
      "npx --prefix frontend prettier --write"
    ],
    "frontend/src/**/*.css": [
      "npx --prefix frontend prettier --write"
    ],
    "backend/src/**/*.ts": [
      "npx --prefix backend prettier --write"
    ]
  }
}
