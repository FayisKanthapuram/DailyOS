# ============================================================
# DailyOS Frontend — Environment Configuration
# ============================================================
# DEVELOPMENT: Copy to frontend/.env.local and fill in values.
# PRODUCTION:  Set all values via Vercel Dashboard → Settings → Environment Variables.
# NEVER commit a file containing real values.
# ============================================================

# ── Production Site URL ───────────────────────────────────────
# Used for canonical URLs, sitemap.xml, robots.txt Sitemap: line, and OG image URLs.
# The postbuild prerender script will FAIL in production if this is not set.
# Development: http://localhost:5173
# Production example: VITE_SITE_URL=https://dailyos.vercel.app
VITE_SITE_URL=http://localhost:5173

# ── Production API Base URL ──────────────────────────────────
# Points the Axios API client to the backend.
# Development: /api (Vite dev server proxies /api → localhost:3001)
# Production:  https://<render-backend-name>.onrender.com/api
#   IMPORTANT: After deploying to Render, set this to the full Render URL.
#   Example: VITE_API_URL=https://dailyos-api.onrender.com/api
VITE_API_URL=/api

# ── Analytics Provider ────────────────────────────────────────
# Options: none | plausible | umami
# Defaults to "none" (no tracking) if not set.
VITE_ANALYTICS_PROVIDER=none
